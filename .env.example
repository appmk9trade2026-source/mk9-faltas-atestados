# =============================================================================
# CRM MK9 — Variáveis públicas do frontend
# Apenas chaves PÚBLICAS. Nunca commitar .env real.
# Nunca colocar service_role, senha de banco ou tokens administrativos.
# =============================================================================

# URL pública do backend (Lovable Cloud)
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Chave publishable / anon (segura para frontend)
VITE_SUPABASE_PUBLISHABLE_KEY="publishable-ou-anon-key"
VITE_SUPABASE_PROJECT_ID="seu-project-ref"

# Identificação da aplicação
VITE_APP_NAME="CRM MK9"
VITE_APP_VERSION="1.0.0"

# Ambiente lógico da build: development | preview | homologacao | production
VITE_APP_ENV="development"

# Data do build (ISO 8601). Injete via CI/CD, por exemplo:
#   VITE_APP_BUILD_DATE=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
VITE_APP_BUILD_DATE=""

# Commit curto (7 chars). Injete via CI/CD:
#   VITE_APP_COMMIT=$(git rev-parse --short HEAD)
VITE_APP_COMMIT=""

# Feature flags (bloqueadas automaticamente em produção pelo lib/env.ts)
VITE_ENABLE_TEST_FEATURES="false"
VITE_ENABLE_DEBUG_LOGS="false"
